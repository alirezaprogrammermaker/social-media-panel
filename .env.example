# ===========================================
# Social Media Panel - Environment Variables
# ===========================================
# Copy this file to .dev.vars for local development:
#   cp .env.example .dev.vars
#
# For production, set these as Wrangler secrets:
#   wrangler secret put SEED_ADMIN_SECRET
# ===========================================

# Secret key required to create the first admin user via /api/auth/seed-admin
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEED_ADMIN_SECRET=change-me-to-a-random-secret

# --- Crypto Payment Gateway (optional) ---
# Create API key in gateway /admin/api-keys (prefix cg_). Never put mnemonic/private keys here.
# Production: wrangler secret put CRYPTO_GATEWAY_API_KEY
#             wrangler secret put CRYPTO_GATEWAY_WEBHOOK_SECRET
CRYPTO_GATEWAY_API_KEY=
CRYPTO_GATEWAY_WEBHOOK_SECRET=
# Optional override (defaults to live gateway in wrangler.jsonc vars)
# CRYPTO_GATEWAY_BASE_URL=https://crypto-gateway.social-panel.workers.dev
